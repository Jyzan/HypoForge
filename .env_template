# Base Model Configuration
OPENAI_BASE_URL=https://ws-sm2imwfgji6oo7tq.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
ANTHROPIC_BASE_URL=https://ws-sm2imwfgji6oo7tq.cn-beijing.maas.aliyuncs.com/apps/anthropic
ANTHROPIC_API_KEY=

# Entity Embedding (for entity normalization in M2/M3)
# Set these if the embedding endpoint differs from OPENAI_BASE_URL.
# Falls back to OPENAI_BASE_URL / OPENAI_API_KEY when unset.
ENTITY_EMBEDDING_BASE_URL=https://ws-sm2imwfgji6oo7tq.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ENTITY_EMBEDDING_API_KEY=

# PubMed E-utilities
NCBI_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/
NCBI_API_KEY=

# Semantic Scholar
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1/
SEMANTIC_SCHOLAR_API_KEY=
# Free / trial S2 keys have very strict rate limits.  Adjust if your key
# tier allows faster polling (paid keys: 0.5–1.0; trial: 3.0–5.0+).
# SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=5.0

# Mandatory general academic discovery for the domain-routed M2 profile.
SERPER_API_KEY=
# Serper Scholar was stable at four starts/second in the 300-request test.
SERPER_REQUESTS_PER_SECOND=4

# OpenAlex metadata/enrichment. OpenAlex requires an API key for normal use.
# OPENALEX_MAILTO and CROSSREF_MAILTO may use the same contact email.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
CROSSREF_MAILTO=

# Open-access DOI resolution. Unpaywall requires a real contact email.
UNPAYWALL_EMAIL=

# Astronomy specialist source. Other routed specialist sources currently use
# documented public endpoints without API keys.
ADS_API_TOKEN=

# Refinement workbench (refinement_assistant/) LLM configuration.
# The workbench reads QWEN_* directly; leave empty to reuse OPENAI_* above.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# Optional embedding model for the workbench RAG (keyword-only when empty).
QWEN_EMBEDDING_MODEL=

# Interpreter used by the Web UI to auto-start the refinement workbench
# when clicking "固定此方案并细化" (leave empty to use the current python).
REFINEMENT_PYTHON=
